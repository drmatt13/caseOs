// Stripe subscription statuses include values like incomplete, trialing, active, past_due, canceled, unpaid, and paused, so your app should sync access from Stripe events, not manually guess it.

model User {
  // in use
  id                           String             @id @default(uuid()) @db.Uuid
  cognitoSub                   String             @unique @map("cognito_sub")
  email                        String             @unique
  billingEmail                 String?            @map("billing_email")
  displayName                  String?            @map("display_name")
  firstName                    String             @map("first_name")
  lastName                     String             @map("last_name")
  profilePicture               String?            @map("profile_picture")
  createdAt                    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  // stripe related
  accountTier                  AccountTier        @default(FREE) @map("account_tier")
  stripeCustomerId             String?            @unique @map("stripe_customer_id")
  stripeDefaultPaymentMethodId String?            @map("stripe_default_payment_method_id")
  cancelAtPeriodEnd            Boolean            @default(false) @map("cancel_at_period_end")
  stripePriceId                String?            @map("stripe_price_id")
  stripeProductId              String?            @map("stripe_product_id")
  stripeSubscriptionId         String?            @unique @map("stripe_subscription_id")
  subscriptionStatus           SubscriptionStatus @default(INACTIVE) @map("subscription_status")
  hasHadActiveSubscription     Boolean            @default(false) @map("has_had_active_subscription")
  // relationships
  ownedWorkspaces              Workspace[]        @relation("WorkspaceOwner")

  // questionable
  userName           String?          @unique @map("user_name")
  isPlatformAdmin    Boolean          @default(false) @map("is_platform_admin")
  accountStatus      AccountStatus    @default(ACTIVE) @map("account_status")
  billingInterval    BillingInterval? @map("billing_interval")
  currentPeriodStart DateTime?        @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?        @map("current_period_end") @db.Timestamptz(6)
  trialStartsAt      DateTime?        @map("trial_starts_at") @db.Timestamptz(6)
  trialEndsAt        DateTime?        @map("trial_ends_at") @db.Timestamptz(6)

  workspaceMemberships WorkspaceMembership[]
  sentWorkspaceInvitations WorkspaceInvitation[] @relation("WorkspaceInvitationInvitedBy")

  // Case knowledge graph back-relations
  createdCases      Case[]         @relation("CaseCreatedByUser")
  createdRecords    CaseRecord[]   @relation("RecordCreatedByUser")
  approvedRecords   CaseRecord[]   @relation("RecordApprovedByUser")
  uploadedDocuments CaseDocument[] @relation("DocumentUploadedByUser")

  // actorUsageEvents     LlmUsageEvent[]       @relation("LlmUsageActorUser")
  // billedUsageEvents    LlmUsageEvent[]       @relation("LlmUsageBilledToUser")
  // stripeEvents                StripeEventLog[]
  // individualUsageMonthly      UserUsageMonthly[]
  // workspaceBilledUsageMonthly WorkspaceUsageMonthly[]

  @@index([accountTier])
  @@index([accountStatus])
  @@map("users")
}

model Workspace {
  // in use
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  description String?
  ownerUserId String          @map("owner_user_id") @db.Uuid
  status      WorkspaceStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       User                  @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships WorkspaceMembership[]

  // Case knowledge graph back-relations
  cases Case[]

  // llmUsageEvents  LlmUsageEvent[]
  // monthlyUsage    WorkspaceUsageMonthly[]
  // stripeEvents    StripeEventLog[]

  workspaceInvitations WorkspaceInvitation[]

  @@index([ownerUserId])
  @@index([status])
  @@map("workspaces")
}

model WorkspaceMembership {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  role             MembershipRole
  membershipStatus MembershipStatus @default(ACTIVE) @map("membership_status")

  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId])
  @@map("workspace_memberships")
}

model WorkspaceInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  workspaceId     String           @map("workspace_id") @db.Uuid
  invitedByUserId String?          @map("invited_by_user_id") @db.Uuid
  email           String
  role            MembershipRole   @default(READONLY)
  invitationToken String           @unique @map("invitation_token")
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([invitedByUserId])
  @@index([email])
  @@index([workspaceId, email, status])
  @@index([status, expiresAt])
  @@map("workspace_invitations")
}

